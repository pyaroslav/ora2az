# Copy this file to .env and fill in the values. .env is git-ignored.
# All three values are inlined into the browser bundle, so keep secrets out of them.

# Organization that owns the app. Read by sanity.cli.ts for `sanity dev` / `sanity deploy`.
SANITY_APP_ORGANIZATION_ID=

# Project and dataset the desk reads and writes. Read by src/config.ts.
SANITY_APP_PROJECT_ID=
SANITY_APP_DATASET=production
